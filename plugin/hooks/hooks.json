{
  "description": "Native Codex push injection for SCAR negative knowledge.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" codex-session-notice",
            "timeout": 10,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" codex-pretool",
            "timeout": 10,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" codex-posttool",
            "timeout": 10,
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
